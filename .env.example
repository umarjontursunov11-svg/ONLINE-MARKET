# Copy this file to .env for local development (python server.py).
# .env is gitignored - never commit real values.

ADMIN_USERNAME=admin

# Local server (server.py) only: plain password
ADMIN_PASSWORD=

# Session signing secret (server.py and Vercel)
ADMIN_JWT_SECRET=

# Vercel only: bcrypt hash of the password (node scripts/hash-password.js "<password>")
ADMIN_PASSWORD_HASH=

# Telegram group notifications for orders (server.py and Vercel)
# New token from @BotFather; the bot must be a member of the group
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1003964640399
